{
  "name": "telegram-basketball-attendance-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create basketball-attendance",
    "db:migrate:local": "wrangler d1 migrations apply basketball-attendance --local",
    "db:migrate:remote": "wrangler d1 migrations apply basketball-attendance --remote",
    "types": "wrangler types",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "webhook:info": "tsx scripts/webhook-info.ts",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
